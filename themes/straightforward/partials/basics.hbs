{{#resume.basics}}
  <div class='basics'>
    <div id='basics-left-content'>
      {{!-- note: this content should not appear or have any effect on styling, this is only to enable any automated content parsing --}}
      <div class='display-none'>
        {{#location}}
          <span class='address'>
            {{address}} {{city}} {{region}} {{postalCode}}
          </span>
        {{/location}}
        {{#if phone}}
          <span class='phone'>
            <a href="tel:{{phone}}">{{phone}}</a>
          </span>
        {{/if}}
      </div>
    </div>

    <div id='basics-center-content'>
      <span class='name'>{{name}}</span>
    </div>

    <div id='basics-right-content'>
      <div class='contact-block'>
        {{#if email}}
          <div>
            <span class='email'>
              <a href="mailto:{{email}}">{{email}}</a>
            </span>
          </div>
        {{/if}}
        {{#if phone}}
          <div>
            <span class='phone'>
              <a href="tel:{{phone}}">{{phone}}</a>
            </span>
          </div>
        {{/if}}
        {{#if url}}
          <div>
            <span class='url'>
              <a href='{{url}}'>{{url}}</a>
            </span>
          </div>
        {{/if}}
        {{#location}}
          <div>
            <span class='address'>{{city}}, {{STATE_ABBREVIATION_TO_FULL_NAME region}}</span>
          </div>
        {{/location}}
        {{#each profiles}}
          {{#if url}}
            <div>
              <span class='url'><a href='{{url}}'>{{STRIP_PROTOCOL url}}</a></span>
            </div>
          {{/if}}
        {{/each}}
      </div>

    </div>
  </div>

{{/resume.basics}}
